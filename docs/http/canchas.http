# Canchas y tipos de cancha — peticiones para la extensión REST Client.
#
# Requiere el entorno "local" de REST Client con adminCorreo y adminPassword
# (ver auth.http). Ejecutá las peticiones en orden: los ids salen de las
# respuestas con nombre, porque IDENTITY no reutiliza valores.
#
# Solo se usan canchas de prueba (Prueba 1, Prueba 2); nunca se editan las del
# seed: el seed es idempotente por nombre y, si se renombra una, crearía otra.
# Si quedaron canchas de prueba de una corrida anterior, hacé primero la
# limpieza de abajo.

@base = http://localhost:3000/api
@prueba1 = {{crearPrueba1.response.body.data.id}}
@prueba2 = {{crearPrueba2.response.body.data.id}}
@manana = {{$localDatetime "YYYY-MM-DD" 1 d}}

### Login admin → 200
# @name loginAdmin
POST {{base}}/auth/login
Content-Type: application/json

{
  "correo": "{{adminCorreo}}",
  "password": "{{adminPassword}}"
}

### Login cliente1 → 200
# @name loginCliente
POST {{base}}/auth/login
Content-Type: application/json

{
  "correo": "cliente1@prueba.local",
  "password": "Cliente123!"
}

### Filtrar por tipo SALA → 200, solo canchas SALA
GET {{base}}/canchas?tipo=SALA
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Tipo inexistente → 200 con []
GET {{base}}/canchas?tipo=XXX
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Tipos de cancha → 200 [{ id, codigo, nombre, precioHora }]
# @name listarTipos
GET {{base}}/tipos-cancha
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Crear Prueba 1 (SALA) → 201, activa
# @name crearPrueba1
POST {{base}}/canchas
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "  Prueba 1  ",
  "tipoCanchaId": {{listarTipos.response.body.data[0].id}}
}

### Crear Prueba 2 (SALA) → 201
# @name crearPrueba2
POST {{base}}/canchas
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 2",
  "tipoCanchaId": {{listarTipos.response.body.data[0].id}}
}

### Detalle de Prueba 1 → 200
GET {{base}}/canchas/{{prueba1}}
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Nombre duplicado → 400 VALIDACION
POST {{base}}/canchas
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 1",
  "tipoCanchaId": {{listarTipos.response.body.data[0].id}}
}

### Tipo inexistente → 400 VALIDACION
POST {{base}}/canchas
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 3",
  "tipoCanchaId": 999999
}

### Cliente crea una cancha → 403 SIN_PERMISO
POST {{base}}/canchas
Authorization: Bearer {{loginCliente.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 3",
  "tipoCanchaId": {{listarTipos.response.body.data[0].id}}
}

### Sin token → 401 NO_AUTENTICADO
GET {{base}}/canchas

### Editar Prueba 2: pasa a CAMPO → 200
PUT {{base}}/canchas/{{prueba2}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 2",
  "tipoCanchaId": {{listarTipos.response.body.data[1].id}}
}

### Editar sin cambios → 200, sin auditoría nueva
PUT {{base}}/canchas/{{prueba2}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 2",
  "tipoCanchaId": {{listarTipos.response.body.data[1].id}}
}

### Renombrar Prueba 2 a Prueba 1 → 400 VALIDACION (duplicado en PUT)
PUT {{base}}/canchas/{{prueba2}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "nombre": "Prueba 1",
  "tipoCanchaId": {{listarTipos.response.body.data[1].id}}
}

### Baja de Prueba 1, sin reservas → 200 (activa: false, reservasCanceladas: 0)
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "motivo": "Mantenimiento"
}

### Baja otra vez → 409 TRANSICION_INVALIDA
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{}

### Admin, sin incluirInactivas → 200, sin Prueba 1
GET {{base}}/canchas
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Admin, incluirInactivas=true → 200, con Prueba 1 (activa: false)
GET {{base}}/canchas?incluirInactivas=true
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Cliente, sin incluirInactivas → 200, sin Prueba 1
GET {{base}}/canchas
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Cliente, incluirInactivas=true → 200, sin Prueba 1 (se ignora)
GET {{base}}/canchas?incluirInactivas=true
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Detalle de Prueba 1 inactiva como cliente → 404 NO_ENCONTRADO
GET {{base}}/canchas/{{prueba1}}
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Detalle de Prueba 1 inactiva como admin → 200 (activa: false)
GET {{base}}/canchas/{{prueba1}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Alta de Prueba 1 → 200 (activa: true)
PATCH {{base}}/canchas/{{prueba1}}/alta
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "motivo": "Mantenimiento terminado"
}

### Alta otra vez → 409 TRANSICION_INVALIDA
PATCH {{base}}/canchas/{{prueba1}}/alta
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{}

### Baja como cliente → 403 SIN_PERMISO
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginCliente.response.body.data.token}}
Content-Type: application/json

{}

### Baja con confirmar como texto → 400 VALIDACION
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "confirmar": "true"
}

### Baja con motivo de 201 caracteres → 400 VALIDACION (máximo 200)
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "motivo": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
}

### Baja de una cancha inexistente → 404 NO_ENCONTRADO
PATCH {{base}}/canchas/999999/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{}

### Id no numérico → 400 VALIDACION
GET {{base}}/canchas/abc
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Precio válido de SALA → 200
PUT {{base}}/tipos-cancha/{{listarTipos.response.body.data[0].id}}/precio
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "precioHora": 650.5
}

### Precio con 3 decimales → 400 VALIDACION
PUT {{base}}/tipos-cancha/{{listarTipos.response.body.data[0].id}}/precio
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "precioHora": 12.345
}

### Precio 0 → 400 VALIDACION
PUT {{base}}/tipos-cancha/{{listarTipos.response.body.data[0].id}}/precio
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "precioHora": 0
}

### Restaurar SALA a 600 → 200
PUT {{base}}/tipos-cancha/{{listarTipos.response.body.data[0].id}}/precio
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "precioHora": 600
}

### Restaurar CAMPO a 1200 → 200
PUT {{base}}/tipos-cancha/{{listarTipos.response.body.data[1].id}}/precio
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "precioHora": 1200
}

### Auditoría de Prueba 1 → 200, 3 filas: ALTA (INACTIVA → ACTIVA, motivo "Mantenimiento terminado"), BAJA (ACTIVA → INACTIVA, motivo "Reservas canceladas: 0. Motivo: Mantenimiento") y CREAR (null → ACTIVA, motivo "Nombre: Prueba 1; tipo: SALA"). La baja repetida y las rechazadas no agregan filas
GET {{base}}/auditoria?entidad=CANCHA&entidadId={{prueba1}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Auditoría de Prueba 2 → 200, 2 filas: EDITAR (motivo "tipo: SALA → CAMPO") y CREAR. El PUT sin cambios y el renombre fallido no agregan filas
GET {{base}}/auditoria?entidad=CANCHA&entidadId={{prueba2}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}

# ─── Baja con reservas (#20) ────────────────────────────────────────────────
# Prueba 1 necesita horario para que cliente1 reserve en ella. Las reservas son
# de mañana: la baja las cancela con reembolso del 100 %.

### Horario de Prueba 1: toda la semana de 07:00 a 22:00 → 200
PUT {{base}}/canchas/{{prueba1}}/horarios
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "dias": [
    { "diaSemana": 1, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 2, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 3, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 4, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 5, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 6, "apertura": "07:00", "cierre": "22:00" },
    { "diaSemana": 7, "apertura": "07:00", "cierre": "22:00" }
  ]
}

### Reserva de cliente1 en Prueba 1, mañana a las 19:00 → 201 PAGADA
# @name reserva1
POST {{base}}/reservas
Authorization: Bearer {{loginCliente.response.body.data.token}}
Content-Type: application/json

{
  "canchaId": {{prueba1}},
  "inicio": "{{manana}}T19:00:00"
}

### Reserva de cliente1 en Prueba 1, mañana a las 20:00 → 201 PAGADA
POST {{base}}/reservas
Authorization: Bearer {{loginCliente.response.body.data.token}}
Content-Type: application/json

{
  "canchaId": {{prueba1}},
  "inicio": "{{manana}}T20:00:00"
}

### Baja sin confirmar → 409 CANCHA_CON_RESERVAS ("La cancha tiene 2 reservas activas...")
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "motivo": "Techo dañado"
}

### Detalle de Prueba 1 → 200, activa: true (el 409 deshizo el UPDATE)
GET {{base}}/canchas/{{prueba1}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Baja con confirmar → 200 (activa: false, reservasCanceladas: 2)
PATCH {{base}}/canchas/{{prueba1}}/baja
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "confirmar": true,
  "motivo": "Techo dañado"
}

### Reserva de las 19:00 → 200 CANCELADA, montoPenalizado 0, pagos CARGO y REEMBOLSO SIM-R-<id> por el total
GET {{base}}/reservas/{{reserva1.response.body.data.id}}
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Notificaciones de cliente1 → incluye "Reserva #<id> cancelada por baja de la cancha: ... Reembolso total: C$ 600.00" por cada una
GET {{base}}/notificaciones
Authorization: Bearer {{loginCliente.response.body.data.token}}

### Reservar en Prueba 1 dada de baja → 404 NO_ENCONTRADO
POST {{base}}/reservas
Authorization: Bearer {{loginCliente.response.body.data.token}}
Content-Type: application/json

{
  "canchaId": {{prueba1}},
  "inicio": "{{manana}}T21:00:00"
}

### Horario de Prueba 1 → 200, los 7 días siguen guardados (la baja no los borra)
GET {{base}}/canchas/{{prueba1}}/horarios
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### Auditoría de Prueba 1 → la fila más nueva es BAJA (ACTIVA → INACTIVA, motivo "Reservas canceladas: 2. Motivo: Techo dañado"); el 409 no dejó fila
GET {{base}}/auditoria?entidad=CANCHA&entidadId={{prueba1}}
Authorization: Bearer {{loginAdmin.response.body.data.token}}

# Verificación en SSMS (las reservas de Prueba 1 son las únicas de esa cancha):
#
#   DECLARE @cancha INT = (SELECT Id FROM Cancha WHERE Nombre = N'Prueba 1');
#   -- 2 filas CANCELADA, Activa 0, MontoPenalizado 0.00
#   SELECT Id, Estado, Activa, Monto, MontoPenalizado FROM Reserva WHERE CanchaId = @cancha;
#   -- Por reserva: CARGO SIM-C-<id> y REEMBOLSO SIM-R-<id> por el mismo monto
#   SELECT ReservaId, Tipo, Monto, Referencia FROM Pago
#   WHERE ReservaId IN (SELECT Id FROM Reserva WHERE CanchaId = @cancha) ORDER BY ReservaId, Id;
#   -- Por reserva: CREAR y CANCELAR, este con el admin y motivo "... Motivo: baja de la cancha"
#   SELECT EntidadId, Accion, EstadoAnterior, EstadoNuevo, UsuarioId, Motivo FROM Auditoria
#   WHERE Entidad = 'RESERVA'
#     AND EntidadId IN (SELECT Id FROM Reserva WHERE CanchaId = @cancha) ORDER BY EntidadId, Id;

### Alta de Prueba 1 → 200 (activa: true)
PATCH {{base}}/canchas/{{prueba1}}/alta
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{}

# ---------------------------------------------------------------------------
# Limpieza al terminar, en SSMS, en este orden (cada tabla depende de la anterior):
#
#   DELETE FROM Notificacion
#   WHERE ReservaId IN (SELECT r.Id FROM Reserva r JOIN Cancha c ON c.Id = r.CanchaId WHERE c.Nombre LIKE N'Prueba%');
#   DELETE FROM Pago
#   WHERE ReservaId IN (SELECT r.Id FROM Reserva r JOIN Cancha c ON c.Id = r.CanchaId WHERE c.Nombre LIKE N'Prueba%');
#   DELETE FROM Auditoria
#   WHERE Entidad = 'RESERVA'
#     AND EntidadId IN (SELECT r.Id FROM Reserva r JOIN Cancha c ON c.Id = r.CanchaId WHERE c.Nombre LIKE N'Prueba%');
#   DELETE FROM Reserva WHERE CanchaId IN (SELECT Id FROM Cancha WHERE Nombre LIKE N'Prueba%');
#   DELETE FROM Horario WHERE CanchaId IN (SELECT Id FROM Cancha WHERE Nombre LIKE N'Prueba%');
#   DELETE FROM Auditoria
#   WHERE Entidad = 'CANCHA'
#     AND EntidadId IN (SELECT Id FROM Cancha WHERE Nombre LIKE N'Prueba%');
#   DELETE FROM Cancha WHERE Nombre LIKE N'Prueba%';
# ---------------------------------------------------------------------------
