# Servidor
PORT=3000

# Base de datos
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ZacariasGuerra
DB_USER=zg_app
# Con Docker Compose también crea el login de la app en el contenedor: mínimo 8 caracteres
# con 3 de estos 4: mayúsculas, minúsculas, dígitos y símbolos. Si la cambiás, cambiala
# también en tu SQL Server local (README, sección "Con Docker").
DB_PASSWORD=
# true en SQL Server Express local; false en Azure SQL
DB_CONFIAR_CERTIFICADO=true

# Autenticación
JWT_SECRETO=
JWT_EXPIRA=8h

# Administrador inicial: solo las exige npm run db:seed
SEED_ADMIN_CORREO=
SEED_ADMIN_PASSWORD=
# Clientes de prueba del seed (cliente1 y cliente2, ver db/README.md): true en local, false en producción
SEED_CLIENTES_PRUEBA=true

# Docker Compose: contraseña de sa del SQL Server del contenedor (solo la usa compose.yaml).
# Mínimo 8 caracteres con 3 de estos 4: mayúsculas, minúsculas, dígitos y símbolos.
MSSQL_SA_PASSWORD=
